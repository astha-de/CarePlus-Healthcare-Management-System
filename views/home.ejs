<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CarePlus Healthcare</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- Navbar -->
    <%- include("partials/navbar") %>


    <!-- Hero Section -->
    <main>

        <section class="hero">

            <div class="container">

                <div class="hero-content">

                    <span class="hero-badge">
                        Trusted Healthcare Management
                    </span>

                    <h1>
                        Quality Healthcare,
                        <br>
                        <span>Just One Click Away</span>
                    </h1>

                    <p>
                        Find trusted doctors, book appointments,
                        manage your healthcare and keep track of
                        your medical records in one place.
                    </p>

                    <div class="hero-buttons">

                        <a href="/patient/doctors" class="btn btn-primary">
                            Find a Doctor
                        </a>

                        <a href="/auth/register" class="btn btn-secondary">
                            Create Account
                        </a>

                    </div>

                </div>

            </div>

        </section>


        <!-- Features -->
        <section class="features-section">

            <div class="container">

                <div class="section-heading">
                    <span>OUR SERVICES</span>

                    <h2>
                        Everything You Need for Better Healthcare
                    </h2>

                    <p>
                        CarePlus makes healthcare management
                        simple, convenient and accessible.
                    </p>
                </div>


                <div class="features-grid">

                    <div class="feature-card">

                        <div class="feature-icon">
                            👨‍⚕️
                        </div>

                        <h3>Find Doctors</h3>

                        <p>
                            Search doctors by specialization
                            and department.
                        </p>

                    </div>


                    <div class="feature-card">

                        <div class="feature-icon">
                            📅
                        </div>

                        <h3>Book Appointment</h3>

                        <p>
                            Schedule your appointment easily
                            from anywhere.
                        </p>

                    </div>


                    <div class="feature-card">

                        <div class="feature-icon">
                            📋
                        </div>

                        <h3>Medical Records</h3>

                        <p>
                            Access and manage your medical
                            records securely.
                        </p>

                    </div>


                    <div class="feature-card">

                        <div class="feature-icon">
                            🔒
                        </div>

                        <h3>Secure & Simple</h3>

                        <p>
                            A clean and easy-to-use healthcare
                            management system.
                        </p>

                    </div>

                </div>

            </div>

        </section>

    </main>


    <!-- Footer -->
    <footer class="footer">

        <div class="container footer-content">

            <div>
                <h3>CarePlus</h3>

                <p>
                    Healthcare made simple, secure and accessible.
                </p>
            </div>

            <div>
                <p>
                    © 2026 CarePlus Healthcare Management System
                </p>
            </div>

        </div>

    </footer>

</body>

</html>