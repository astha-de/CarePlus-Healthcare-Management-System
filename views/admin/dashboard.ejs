<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Dashboard | CarePlus</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>

    <%- include("../partials/navbar") %>

    <main class="admin-dashboard">

        <div class="admin-container">

            <div class="admin-header">

                <span>CAREPLUS HEALTHCARE</span>

                <h1>
                    Welcome, <strong><%= currentUser.name %></strong>
                </h1>

                <p>
                    Manage doctors, patients and departments from your dashboard.
                </p>

            </div>


            <div class="admin-stats">

                <div class="admin-stat-card">
                    <h3>Total Doctors</h3>
                    <strong><%= totalDoctors %></strong>
                </div>

                <div class="admin-stat-card">
                    <h3>Total Patients</h3>
                    <strong><%= totalPatients %></strong>
                </div>

                <div class="admin-stat-card">
                    <h3>Departments</h3>
                    <strong><%= totalDepartments %></strong>
                </div>

                <div class="admin-stat-card">
                    <h3>Total Users</h3>
                    <strong><%= totalUsers %></strong>
                </div>

            </div>


            <section class="admin-management">

                <h2>Management</h2>

                <div class="management-grid">

    <div class="management-card">
        <h3>Manage Doctors</h3>

        <p>
            Add, edit and remove doctors from the healthcare system.
        </p>

        <a href="/admin/doctors">
            Manage Doctors
        </a>
    </div>


    <div class="management-card">
        <h3>Manage Patients</h3>

        <p>
            View registered patients and their information.
        </p>

        <a href="/admin/patients">
            Manage Patients
        </a>
    </div>


    <div class="management-card">
        <h3>Manage Departments</h3>

        <p>
            Add and manage healthcare departments.
        </p>

        <a href="/admin/departments">
            Manage Departments
        </a>
    </div>


    <!-- ADD THIS CARD -->

    <div class="management-card">
        <h3>Manage Appointments</h3>

        <p>
            View and manage all patient appointments and their status.
        </p>

        <a href="/admin/appointments">
            Manage Appointments
        </a>
    </div>

</div>

    </main>

    <%- include("../partials/footer") %>

</body>

</html>