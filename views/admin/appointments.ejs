<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Manage Appointments | CarePlus</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/admin-appointments.css">
</head>

<body>

    <%- include("../partials/navbar") %>

    <main class="dashboard-page">

        <div class="dashboard-container">

            <!-- HEADER -->
            <section class="welcome-box">
                <div>
                    <p>CAREPLUS HEALTHCARE</p>
                    <h1>Manage Appointments</h1>
                    <p>View and manage all patient appointments.</p>
                </div>
            </section>


            <!-- APPOINTMENTS -->
            <section class="dashboard-section">

                <div class="section-heading">
                    <div>
                        <h2>All Appointments</h2>
                        <p>Manage patient appointments and their status.</p>
                    </div>
                </div>


                <% if (appointments.length === 0) { %>

                    <div class="empty-state">

                        <div class="empty-icon">📅</div>

                        <h3>No Appointments</h3>

                        <p>
                            There are no appointments in the system yet.
                        </p>

                    </div>

                <% } else { %>

                    <div class="appointments-list">

                        <% appointments.forEach(appointment => { %>

                            <div class="admin-appointment-card">

                                <!-- HEADER -->

                                <div class="appointment-header">

                                    <div>

                                        <h3>
                                            <%= appointment.patient && appointment.patient.user
                                                ? appointment.patient.user.name
                                                : "Patient" %>
                                        </h3>

                                        <p>
                                            <%= appointment.patient && appointment.patient.user
                                                ? appointment.patient.user.email
                                                : "Email not available" %>
                                        </p>

                                    </div>


                                    <span class="status-badge <%= appointment.status.toLowerCase() %>">
                                        <%= appointment.status %>
                                    </span>

                                </div>


                                <!-- DETAILS -->

                                <div class="appointment-details">

                                    <div class="detail-item">

                                        <span>Doctor</span>

                                        <strong>
                                            <%= appointment.doctor
                                                ? appointment.doctor.name
                                                : "Doctor" %>
                                        </strong>

                                    </div>


                                    <div class="detail-item">

                                        <span>Department</span>

                                        <strong>
                                            <%= appointment.doctor && appointment.doctor.department
                                                ? appointment.doctor.department.name
                                                : "N/A" %>
                                        </strong>

                                    </div>


                                    <div class="detail-item">

                                        <span>Date</span>

                                        <strong>
                                            <%= new Date(
                                                appointment.appointmentDate
                                            ).toLocaleDateString("en-IN", {
                                                day: "2-digit",
                                                month: "short",
                                                year: "numeric"
                                            }) %>
                                        </strong>

                                    </div>


                                    <div class="detail-item">

                                        <span>Time</span>

                                        <strong>
                                            <%= appointment.appointmentTime %>
                                        </strong>

                                    </div>


                                    <div class="detail-item reason">

                                        <span>Reason</span>

                                        <strong>
                                            <%= appointment.reason %>
                                        </strong>

                                    </div>

                                </div>


                                <!-- ACTIONS -->

                                <!-- ACTIONS -->

<div class="appointment-actions">

    <% if (appointment.status === "Pending") { %>

        <!-- ADMIN CONFIRM -->
        <form
            action="/appointments/admin/confirm/<%= appointment._id %>"
            method="POST"
        >
            <button
                type="submit"
                class="confirm-btn"
            >
                Confirm
            </button>
        </form>


        <!-- ADMIN REJECT -->
        <form
            action="/appointments/admin/reject/<%= appointment._id %>"
            method="POST"
        >
            <button
                type="submit"
                class="reject-btn"
            >
                Reject
            </button>
        </form>

    <% } %>


    <% if (appointment.status === "Confirmed") { %>

        <!-- ADMIN COMPLETE -->
        <form
            action="/appointments/admin/complete/<%= appointment._id %>"
            method="POST"
        >
            <button
                type="submit"
                class="complete-btn"
            >
                Mark Completed
            </button>
        </form>

    <% } %>


    <!-- ADMIN DELETE -->
    <form
        action="/appointments/admin/delete/<%= appointment._id %>"
        method="POST"
        onsubmit="return confirm('Are you sure you want to delete this appointment?');"
    >
        <button
            type="submit"
            class="delete-btn"
        >
            Delete
        </button>
    </form>

</div>

      </div>

                        <% }) %>

                    </div>

                <% } %>

            </section>

        </div>

    


    <%- include("../partials/footer") %>

</body>

</html>